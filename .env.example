# SmartLoanIT - Plantilla de variables de entorno.
# El archivo .env contiene las credenciales reales y no se versiona.

# En Railway, las variables de MySQL se completan automáticamente al agregar
# el plugin. JWT_SECRET es la variable adicional requerida.

# Puerto HTTP de Express; coincide con el publicado en Docker.
PORT=1002

# Conexión MySQL local. En producción las credenciales son distintas de estos
# valores de ejemplo.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password_de_ejemplo

# Variables de Railway MySQL: si están presentes, tienen prioridad sobre
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME para conectar al plugin.
# MYSQL_HOST=
# MYSQL_PORT=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# Clave de firma de los JWT: única, aleatoria y de al menos 32 caracteres.
# Una filtración permite emitir tokens válidos.
JWT_SECRET=secreto_de_ejemplo_de_32_caracteres_o_mas
# Vigencia de la sesión. Un valor corto reduce el riesgo si un token se compromete.
JWT_EXPIRES_IN=12h

# NODE_ENV=production activa cookies Secure y HSTS; sin esta variable la app asume desarrollo.
# NODE_ENV=production
# Orígenes permitidos para CORS, separados por coma. Vacío = solo mismo origen.
# El comodín no es seguro cuando la API maneja sesiones.
# CORS_ORIGIN=https://example.com
# Se habilita únicamente detrás de Railway/Nginx/otro proxy para leer la IP real del cliente.
TRUST_PROXY=false

# Administrador inicial para producción con base de datos vacía.
# Si no existe ningún administrador activo, el arranque requiere estos valores.
# La contraseña requiere al menos 12 caracteres y se renueva tras el primer ingreso.
# ADMIN_INICIAL_CODIGO=1001
# ADMIN_INICIAL_PASSWORD=clave_larga_de_ejemplo
# ADMIN_INICIAL_NOMBRE=Administrador
# ADMIN_INICIAL_APELLIDO=Sistema