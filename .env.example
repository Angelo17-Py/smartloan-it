# ============================================
# SmartLoan IT - Configuracion del Sistema
# ============================================
# Copia este archivo a .env y ajusta los valores
# En Railway, las variables de MySQL se setean automaticamente
# al agregar el plugin MySQL. Solo necesitas JWT_SECRET.

# Puerto del servidor
PORT=3000

# Base de datos MySQL (local)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=1234
DB_NAME=prestamos_db

# Railway MySQL (se usan automaticamente si estan presentes)
# MYSQL_HOST=
# MYSQL_PORT=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# JWT (Secret para firmar los tokens)
JWT_SECRET=SmartLoanIT_2026_Angelo_Caballero_UNIDA
JWT_EXPIRES_IN=12h
