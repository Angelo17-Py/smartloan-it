# ============================================
# SmartLoan IT - Configuracion del Sistema
# ============================================
# Copia este archivo a .env y ajusta los valores con tus credenciales reales.
# En Railway, las variables de MySQL se setean automaticamente
# al agregar el plugin MySQL. Solo necesitas JWT_SECRET.

# Puerto del servidor
PORT=1002

# Base de datos MySQL (local) - CAMBIA estas credenciales
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# DB_PASSWORD=coloca_tu_password_aqui

# Railway MySQL (se usan automaticamente si estan presentes)
# MYSQL_HOST=
# MYSQL_PORT=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# JWT - CAMBIA este secret por uno unico y seguro (mínimo 32 caracteres)
JWT_SECRET=coloca_un_secret_unico_aqui
JWT_EXPIRES_IN=12h

# Seguridad
# NODE_ENV=production activa cookies Secure y HSTS
# NODE_ENV=production
# Orígenes permitidos para CORS, separados por coma. Vacío = solo mismo origen.
# CORS_ORIGIN=https://tu-dominio.com
# Activar solo si la app está detrás de Railway/Nginx/otro proxy
TRUST_PROXY=false

