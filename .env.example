# ============================================
# SmartLoan IT - Configuracion del Sistema
# ============================================
# Copia este archivo a .env y ajusta los valores

# Puerto del servidor
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=1234
DB_NAME=prestamos_db

# JWT (Secret para firmar los tokens)
JWT_SECRET=CambiaEsteSecretPorUnoSeguro
JWT_EXPIRES_IN=12h
