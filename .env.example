# SmartLoan IT - Configuración de ejemplo del sistema.
# Copia este archivo a .env y ajusta los valores con tus credenciales reales.
# En Railway, las variables de MySQL se setean automáticamente
# al agregar el plugin MySQL. Solo necesitas JWT_SECRET.

# Puerto HTTP en el que escucha Express. Debe coincidir con el publicado en Docker.
PORT=1002

# Conexión MySQL local. Cambia el usuario y la contraseña en producción;
# nunca dejes la contraseña de ejemplo en un entorno real.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloca_tu_password_aqui

# Variables de Railway MySQL: si están presentes, tienen prioridad sobre
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME para conectar al plugin.
# MYSQL_HOST=
# MYSQL_PORT=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# Clave para firmar los JWT. Debe ser única, aleatoria y de al menos 32 caracteres;
# si se filtra, cualquiera podría emitir tokens válidos.
JWT_SECRET=coloca_un_secret_unico_aqui
# Vigencia de la sesión. Un valor corto reduce el riesgo si un token se compromete.
JWT_EXPIRES_IN=12h

# NODE_ENV=production activa cookies Secure y HSTS. Sin él, la app asume desarrollo.
# NODE_ENV=production
# Orígenes permitidos para CORS, separados por coma. Vacío = solo mismo origen;
# no uses comodín si la API maneja sesiones.
# CORS_ORIGIN=https://tu-dominio.com
# Actívalo solo detrás de Railway/Nginx/otro proxy para leer la IP real del cliente.
TRUST_PROXY=false

# Administrador inicial SOLO para producción con base de datos vacía.
# Si no existe ningún administrador activo, el arranque exige estos valores.
# La contraseña debe tener al menos 12 caracteres y cambiarse tras el primer ingreso.
# ADMIN_INICIAL_CODIGO=1001
# ADMIN_INICIAL_PASSWORD=coloca_una_clave_larga_y_unica
# ADMIN_INICIAL_NOMBRE=Administrador
# ADMIN_INICIAL_APELLIDO=Sistema

