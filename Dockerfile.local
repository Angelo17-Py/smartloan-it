# Imagen de desarrollo local: Node ligero, sin pasos de producción.
FROM node:22-alpine

WORKDIR /app

# Copia solo los manifiestos primero para aprovechar la caché de dependencias.
COPY package*.json ./
RUN npm install

# Copia el resto del proyecto (incluye backend y frontend estático).
COPY . .

# Puerto que expone el servidor Express; Compose lo publica en el host.
EXPOSE 1002

CMD ["node", "backend/server.js"]
